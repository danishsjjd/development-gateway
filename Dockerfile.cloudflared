FROM golang:1.27.3-alpine3.23@sha256:8a5046497cda39860b832ffdbe8dd66018a0f05bb01352f533a36e7e2ced66a0 AS builder
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
# Release 2026.10.3, verified upstream source archive; do not follow master.
ADD --checksum=sha256:68d298c522aef45fe8412e0ccf8f21ff12a6ad768aa69cbc23e10eac688ac8c8 https://codeload.github.com/cloudflare/cloudflared/tar.gz/refs/tags/2026.10.3 /tmp/cloudflared.tar.gz
WORKDIR /src
RUN tar -xzf /tmp/cloudflared.tar.gz --strip-components=1 && rm /tmp/cloudflared.tar.gz
# Release locks plus pinned chi/compress security fixes (see SECURITY.md).
# Never resolve new versions during a build.
COPY build/cloudflared/go.mod build/cloudflared/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY build/healthcheck/main.go /healthcheck/main.go
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build -mod=readonly -trimpath \
      -ldflags="-X main.Version=2026.10.3 -X main.BuildTime=2026-10-27 -X github.com/cloudflare/cloudflared/metrics.Runtime=virtual" \
      -o /out/cloudflared ./cmd/cloudflared && \
    go build -trimpath -o /out/healthcheck /healthcheck/main.go

FROM gcr.io/distroless/static-debian13:nonroot@sha256:18f4cc26c9ffa7f20a359298be7deadac5c607c8e03a02b8119f1a5fc2f82c99
COPY --from=builder /out/cloudflared /usr/local/bin/cloudflared
COPY --from=builder /out/healthcheck /usr/bin/healthcheck
USER 1000:1000
ENTRYPOINT ["/usr/local/bin/cloudflared"]
CMD ["version"]
